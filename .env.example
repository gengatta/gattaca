# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram id Катаржины (узнать: написать боту @userinfobot). Несколько — через запятую.
# Маму сюда добавлять не нужно — её приглашают из бота командой /family.
ALLOWED_USER_IDS=

# Ключ Claude API (https://console.anthropic.com) — для расписаний и фото записей.
# Без него бот бесплатно понимает простые сообщения: «завтра 10:00 врач», «сдать эссе до пятницы».
ANTHROPIC_API_KEY=
# Haiku — самая дешёвая модель (доли цента за фото). Если плохо читает почерк — claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5

# Часовой пояс по умолчанию (каждый может поменять себе командой /tz)
TIMEZONE=Europe/Moscow

# Напоминания о встречах: d — дни, h — часы, m — минуты, 0m — в момент начала
DEFAULT_REMINDERS=1d,1h,0m
# Напоминания о задачах: за сколько дней до дедлайна и во сколько
TASK_REMINDERS=2d,1d,0d
TASK_REMIND_TIME=10:00

# Утренний план на день и воскресный обзор недели (меняются в боте: /digest, /weekly)
DIGEST_TIME=08:00
WEEKLY_TIME=19:00

DB_PATH=data/assistant.db
