# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here
# Telegram id Катаржины (узнать: написать боту @userinfobot). Несколько — через запятую.
# Маму сюда добавлять не нужно — её приглашают из бота командой /family.
ALLOWED_USER_IDS=
# Ключ Claude API (https://console.anthropic.com) — для расписаний и фото записей.
# Без него бот понимает только простые сообщения вида «завтра 10:00 врач».
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Часовой пояс
TIMEZONE=Europe/Warsaw
# Когда напоминать по умолчанию: d — дни, h — часы, m — минуты, 0m — в момент начала
DEFAULT_REMINDERS=1d,1h,0m
# Время утренней сводки (можно поменять в боте командой /digest)
DIGEST_TIME=08:00
DB_PATH=data/assistant.db
