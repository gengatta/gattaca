# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here
# Telegram id Катаржины (узнать: написать боту @userinfobot). Несколько — через запятую.
ALLOWED_USER_IDS=
# Часовой пояс
TIMEZONE=Europe/Warsaw
# Когда напоминать по умолчанию: d — дни, h — часы, m — минуты, 0m — в момент начала
DEFAULT_REMINDERS=1d,1h,0m
# Время утренней сводки (можно поменять в боте командой /digest)
DIGEST_TIME=08:00
DB_PATH=data/assistant.db
